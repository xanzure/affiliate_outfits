# Vance Archives — pipeline + worker configuration
# Copy to `.env` and fill in what you need. Every value is optional for running
# the test suite; the defaults below are the safe "shelved" state (dry run, no
# posting, built-in sample products).

# ── Core ────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
ASSETS_DIR=app/assets
# Local SQLite file used by tests and local-only runs. The worker and dashboard
# use Supabase (below) instead.
DATABASE_PATH=data/affiliate_outfits.sqlite3
# true = never call the live TikTok/Pinterest APIs, even if tokens are set.
DRY_RUN=true

# ── Database + storage (Supabase) ── required for the worker and dashboard ──
SUPABASE_URL=
# Server-only. Bypasses RLS. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct Postgres URL (only used by one-off migration scripts).
SUPABASE_DB_URL=

# ── LLM (Anthropic Messages API) ── paid, pay-per-use ───────────────────────
AI_PROVIDER=anthropic
AI_MODE=claude
# Model for the cheap, high-volume agents (captions, replacement concepts).
# The outfit curator is pinned to a stronger model in app/agents/outfit/curator.py.
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# ── Product search ──────────────────────────────────────────────────────────
# fixtures       built-in sample products, free, no key (default)
# apify          Apify e-commerce scraper — paid, needs APIFY_TOKEN (last live provider)
# serpapi        SerpAPI Google Shopping — paid, needs SERPAPI_API_KEY
# awin           local AWIN affiliate catalog (scripts/sync_awin_feeds.py) — free
# tavily         legacy web-search provider — needs TAVILY_API_KEY
PRODUCT_SEARCH_PROVIDER=fixtures
APIFY_TOKEN=
SERPAPI_API_KEY=
TAVILY_API_KEY=
GOOGLE_SHOPPING_LOCATION=United States
GOOGLE_SHOPPING_GL=us
GOOGLE_SHOPPING_HL=en

# ── Affiliate network ───────────────────────────────────────────────────────
AFFILIATE_PROVIDER=none
AWIN_PUBLISHER_ID=
AWIN_OAUTH2_TOKEN=

# ── Image cutouts ── optional; falls back to local rembg when unset ─────────
RUNFLOW_API_KEY=

# ── Publishing ──────────────────────────────────────────────────────────────
# Master switch for live posting and the worker's queue cooldown tick.
AUTOPOSTING_ENABLED=false
# Hours between auto-posts per platform. Set low (e.g. 0.05) to smoke-test.
POST_COOLDOWN_HOURS=24
# Public base URL that serves collage images. TikTok's PULL_FROM_URL requires a
# domain you've verified, so storage is proxied through the site (/media/*).
PUBLIC_ASSET_BASE_URL=

# TikTok Content Posting API — get tokens with scripts/tiktok_auth.py
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_POST_MODE=DIRECT_POST
# Unaudited apps can only post privately.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Pinterest API v5 — get tokens with scripts/pinterest_auth.py
# Trial-access apps must use the sandbox host; switch to
# https://api.pinterest.com once approved for Standard access.
PINTEREST_API_BASE_URL=https://api-sandbox.pinterest.com
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=
