APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=data/affiliate_outfits.sqlite3
DATA_DIR=data
ASSETS_DIR=app/assets
DRY_RUN=true

AI_PROVIDER=anthropic
AI_MODE=claude
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

PRODUCT_SEARCH_PROVIDER=google_shopping
SERPAPI_API_KEY=
GOOGLE_SHOPPING_LOCATION=United States
GOOGLE_SHOPPING_GL=us
GOOGLE_SHOPPING_HL=en

AFFILIATE_PROVIDER=none

AUTOPOSTING_ENABLED=false
PUBLIC_ASSET_BASE_URL=

TIKTOK_ACCESS_TOKEN=
TIKTOK_POST_MODE=DIRECT_POST
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_DISABLE_COMMENT=false
TIKTOK_AUTO_ADD_MUSIC=true
TIKTOK_BRAND_CONTENT_TOGGLE=false
TIKTOK_BRAND_ORGANIC_TOGGLE=false

PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
