# Vance Archives — Next.js site + admin dashboard
# Copy to `web/.env.local` for local dev, or set these in the Vercel project.

# Public (shipped to the browser). Safe only because RLS restricts the anon
# role to read-only access on concepts/outfits/products — see
# app/db/schema_postgres.sql and docs/security.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the dashboard's server actions. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS=

# Skip the /admin login locally. Ignored when NODE_ENV=production.
ADMIN_DEV_BYPASS=false

# Keep in sync with the worker's POST_COOLDOWN_HOURS so the queue countdown matches.
POST_COOLDOWN_HOURS=24
